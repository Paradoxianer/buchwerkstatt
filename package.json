{
  "name": "buchwerkstatt",
  "version": "0.2.0",
  "description": "Google-Docs-Erweiterung für Romanautor:innen: Notizen, Figuren, Orte, Zeitstrahl und Pinnwand neben dem Manuskript.",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "vorschau": "node dev/vorschau.mjs",
    "push": "node dev/version.mjs && clasp push --force",
    "deploy": "npm run push && clasp open",
    "marketplace": "node dev/vorschau.mjs && node dev/marketplace.cjs"
  },
  "devDependencies": {
    "@google/clasp": "^2.4.2"
  }
}
